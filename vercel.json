{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/liturgia",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/santo",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/artigo?slot=1",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/artigo?slot=2",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/artigo?slot=3",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/artigo?slot=4",
      "schedule": "30 22 * * *"
    }
  ],
  "redirects": [
    { "source": "/home",        "destination": "/",           "permanent": true },
    { "source": "/home/",       "destination": "/",           "permanent": true },
    { "source": "/blog/",       "destination": "/blog",       "permanent": true },
    { "source": "/santoral/",   "destination": "/santoral",   "permanent": true },
    { "source": "/liturgia/",   "destination": "/liturgia",   "permanent": true },
    { "source": "/oracoes/",    "destination": "/oracoes",    "permanent": true },
    { "source": "/loja/",       "destination": "/loja",       "permanent": true },
    { "source": "/assinaturas/","destination": "/assinaturas","permanent": true },
    { "source": "/blog/:slug/", "destination": "/blog/:slug", "permanent": true },
    { "source": "/santoral/:id/","destination": "/santoral/:id","permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",         "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Strict-Transport-Security","value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml",           "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)",          "destination": "/index.html" }
  ]
}
